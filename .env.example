# ============================================================
# 이 파일은 커밋됩니다. 실제 키는 .env 에 넣고 절대 커밋 금지.
# 복사: cp .env.example .env
# ============================================================

# ---- Database (Neon PostgreSQL) ----
# Neon 대시보드 → Connection string → "psycopg" 형식 권장
# 예: postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
# market 전용 DB(:5434). 미설정 시 DATABASE_URL 폴백(메인 DB) — 맥 등 미구축 환경용이다.
# 실운영에서는 반드시 설정할 것: 이 키가 없으면 앱별 DB 컷오버가 무경고로 되돌아간다
# (2026-07-24 실제 사고 — 상권 뉴스가 사흘간 메인 DB에 쌓임). 기동 로그에 경고가 남는다.
# k3s 파드·CronJob에서는 host.docker.internal:5434(→172.17.0.1), 호스트 스크립트는 localhost:5434.
MARKET_DATABASE_URL=
# 컨테이너용 — 위 값이 localhost면 컨테이너 안에서 자기 자신을 가리켜 메인 DB로
# 조용히 폴백한다(2026-07-24 실장애). infra/k8s/base/backend.yaml이 이 값을 MARKET_DATABASE_URL로 주입한다.
MARKET_DATABASE_URL_DOCKER=

# ---- Database (로컬 docker-compose pgvector) ----
# infra/docker-compose.yaml의 기본값(redocean)은 공개 저장소에 노출된 값이므로 실제 비밀번호를 여기서 덮어쓴다.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- 공공데이터 API 키 ----
# 서울 열린데이터광장 (data.seoul.go.kr) - 메인 데이터 출처
SEOUL_OPENDATA_API_KEY=

# 공공데이터포털 (data.go.kr) - 보조 데이터 출처
DATA_GO_KR_API_KEY=

# 한국부동산원 R-ONE (www.reb.or.kr/r-one) — 상가 임대료·공실률(scripts/collect_rone_rent.py)
RONE_API_KEY=
# 한국은행 ECOS (ecos.bok.or.kr) — 기준금리·대출금리(scripts/collect_ecos_rates.py)
ECOS_API_KEY=

# ---- Auth (JWT RS256) ---- 생성: minseok/scripts/generate_jwt_keys.sh
# 공개키(검증) — 전 컨테이너 공용. 개인키(발급)는 .env.auth에만 둔다(auth 컨테이너 전용).
JWT_PUBLIC_KEY_B64=

# ---- API 문서 보호 (/docs·/redoc·/openapi.json — HTTP Basic) ----
# 미설정 시 문서 접근 전면 차단. 개발자 브라우저 로그인창 계정.
DOCS_USER=
DOCS_PASSWORD=
# 리프레시 토큰 저장소 — 미설정 시 redis://localhost:6379/0 (컨테이너는 compose가 redis://redis:6379/0 주입)
# REDIS_URL=
# 모바일 세션 전용 — 같은 Redis의 논리 db 1. 웹 세션(db 0)과 키 공간·커넥션을 분리한다.
# REDIS_URL_MOBILE=

# ---- Auth (소셜 로그인 OAuth — 백엔드가 인가 코드 교환에 사용) ----
# 구글: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오: developers.kakao.com → 앱 키의 "REST API 키" (시크릿은 보안 탭에서 켠 경우만)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 앱 ID(숫자) — 앱 설정 > 앱 키 화면의 "앱 ID". REST/네이티브 앱 키와 다른 값이다.
# Flutter 앱이 보낸 카카오 토큰이 우리 앱 것인지 확인하는 데 쓴다(비면 모바일 로그인 전부 거부).
KAKAO_APP_ID=
# 네이버: developers.naver.com → 애플리케이션 등록(네이버 로그인)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- LLM (Phase 4에서 선택, 자리만 준비) ----
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- DART (금융감독원 전자공시) API Key ----
DART_API_KEY=

# ---- Frontend (www/) ----
# Next.js는 www/ 안의 env 파일만 읽는다 — 로컬은 www/.env.local에, 배포는 버셀 환경변수에 설정.
# 카카오맵 JS 키 (developers.kakao.com — 플랫폼>Web 사이트 도메인에 서비스 도메인 등록 필수)
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 백엔드 주소 — rewrites(/api/backend/*)·/api/chat 프록시 대상. 로컬 기본 http://127.0.0.1:8000, 배포는 공개 백엔드 주소

NEXT_PUBLIC_API_URL=

# 소셜 로그인 클라이언트 ID (인가 URL 조립용 — 시크릿은 백엔드에만).

# 각 사 콘솔의 리다이렉트 URI에 <origin>/oauth/google|kakao|naver 를 등록해야 한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=

# ---- IAM ACCESS KEY AWS ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# 어드민 이미지 업로드(POST /admin/images) 저장 버킷. 비어 있으면 그 엔드포인트만 503.
ADMIN_IMAGE_S3_BUCKET=
# ---- Neo4j (그래프DB — docker compose --profile graph 로 선택 기동) ----
# 비밀번호는 볼륨 최초 초기화 시점에만 박힌다. 이후 변경은 cypher-shell의
# ALTER CURRENT USER SET PASSWORD ... 또는 볼륨 폐기 후 재생성(파생본이라 가능).
# 컨테이너 내부는 bolt://neo4j:7687, 호스트 스크립트는 bolt://127.0.0.1:7687.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ---- n8n 웹훅 (수집 적재 · 이메일 발송) ----
# INBOUND: 수집 cron·n8n이 백엔드 /automation/* 을 부를 때 싣는 검증 토큰(비면 검증 생략 — 로컬만).
# OUTBOUND/URL: 백엔드 → n8n 이메일 발송. Gmail 자격증명은 n8n이 보유해 백엔드에 비밀이 없다.
N8N_INBOUND_TOKEN=
N8N_OUTBOUND_TOKEN=
N8N_EMAIL_WEBHOOK_URL=

# ---- pgadmin (DB 브라우저 — docker compose --profile tools up -d pgadmin) ----
# http://127.0.0.1:5050 로그인 계정. 공유 DB·market DB 2개는 _docs/pgadmin-servers.json으로
# 자동 등록되며, DB 비밀번호는 최초 연결 시 한 번 입력하면 pgadmin이 보관한다.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ---- LLM (③-M5 교체 스위치) ----
# 기본 LLM 모델의 Ollama 태그. 비우면 exaone3.5:7.8b(현행).
# 기본 gemma4:e4b-it-qat(Apache 2.0) — 2026-09-15 교체 확정(③-M5②). EXAONE 3.5는 NC 라이선스라
# 공개 서비스에 쓰지 않는다. 교체: ollama pull <태그> → 이 키 설정 → eval 하네스(134문항)로
# 품질 회귀 대조 후 확정(minseok/_docs/LLM_SWAP_EVAL_2026-09-14.md).
LLM_MODEL=gemma4:e4b-it-qat
# 사고(thinking) 모드 — "off"(끔)·"on"(켬)·빈값(모델별 서버 기본). 기본 off — Gemma 4 계열은
# 서버 기본이 켜짐이라 답변당 수십 초가 걸린다. EXAONE 등 비사고 모델은 값과 무관하게 동작.
LLM_THINK=off
# 모델 상주 시간(Ollama keep_alive: "24h"·"30m"·"-1"=영구). 기본 5분이면 유휴 뒤 첫 질문이 10~20초 느리다.
LLM_KEEP_ALIVE=24h
# 임베딩 모델 — 기본 embeddinggemma(768차원, Gemma Terms). 2026-09-15 bge-m3(BAAI, 중국)에서 교체.
# 바꾸면 벡터 차원 마이그레이션(공유 DB·market DB) + 전량 재임베딩이 따른다.
EMBED_MODEL=embeddinggemma
# Ollama 장애(접속 불가·5xx) 시 같은 프롬프트를 Gemini로 보내는 폴백 — "external"이면 켬. 평가 러너는 off.
LLM_FALLBACK=external
# 채팅 동시 처리 상한 — 넘는 요청은 도착 순서대로 기다리고 화면에 대기 순번이 뜬다(core/llm/request_queue.py).
# 백엔드 PC의 Ollama 생성 슬롯이 하나라 기본 1. 올리면 질문끼리 LLM 호출이 번갈아 끼어 둘 다 느려진다.
CHAT_MAX_CONCURRENCY=1

# ---- 운영 관측 (③-M4) ----
# 로그 포맷 — "json"이면 백엔드·auth 전 로그가 한 줄 JSON(운영 검색용).
# 로컬 dev는 비워두면 plain(사람이 읽는 기존 포맷). prod compose가 json으로 켠다.
LOG_FORMAT=

# ---- 운영 알림 ----
# scripts/check_freshness.py(수집 지연·정지 감시)가 보낼 곳. 비어 있으면 발송 단계에서 실패한다.
# 주의: 이 감시는 백엔드 PC 안에서 돈다 — PC가 꺼지면 알림도 오지 않는다.
# 호스트 다운 감지는 외부 업타임 모니터가 https://api.redoceanmap.com/health 를 폴링하는 몫이다.
ALERT_EMAIL=

# ---- Gemini (허브 /gemini/answer 전용) ----
# hub/adapter/outbound/gemini_api_adapter.py가 REST로 직접 호출한다(SDK 미사용).
# 도메인 추론·최종 답변은 EXAONE 단일 모델 정책이 정본이고, 이 경로는 그와 별개다.
GEMINI_API_KEY=
